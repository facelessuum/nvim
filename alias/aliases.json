{
  "f": "nvim_config_open .",
  "calias": "cd \"$NVIM_CONFIG_DIR/alias\"",
  "vimconfig": "cd \"$NVIM_CONFIG_DIR\"",
  "e": "nvim",
  "c": "clear",
  "dev": "npm run dev",
  "start": "npm run start",
  "build": "npm run build",
  "pdev": "pnpm run dev",
  "pstart": "pnpm run start",
  "pbuild": "pnpm run build",
  "gpt": "nvim_config_open https://chat.openai.com/ && exit",
  "deepseek": "nvim_config_open https://chat.deepseek.com/ && exit",
  "ie-res": "pnpm clear && pnpm i && pnpm build && pnpm dev",
  "pewpew": "source .venv/bin/activate",
  "pew": "deactivate"
}
